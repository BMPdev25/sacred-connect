# Backend API base URL
EXPO_PUBLIC_API_URL=https://dev.bookmypujari.online/api

# Phone OTP login (optional) — must match the backend's OTP_ENABLED value,
# otherwise the phone-login tab is hidden/shown out of sync with what the
# backend actually accepts (backend 404s /send-otp and /verify-otp when off).
EXPO_PUBLIC_OTP_ENABLED=false

# Google Sign-In — the Web client ID from Firebase Console -> Authentication
# -> Sign-in method -> Google (enabling that provider generates it). Required
# for the Google Sign-In button on the login screen to work; without it,
# loginWithGoogle() throws immediately. See config/googleSignIn.ts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
