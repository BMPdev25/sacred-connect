{
  "name": "bookmypujari",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:mobile:success": "node scripts/run-maestro.js flow-booking-success.yaml",
    "test:mobile:accept": "node scripts/run-maestro.js flow-priest-acceptance.yaml",
    "test:mobile:payment": "node scripts/run-maestro.js flow-devotee-payment.yaml",
    "test:mobile:cancel-priest": "node scripts/run-maestro.js flow-priest-cancellation.yaml",
    "test:mobile:cancel-devotee": "node scripts/run-maestro.js flow-devotee-cancellation.yaml",
    "test:mobile:complete": "node scripts/run-maestro.js flow-priest-completion.yaml",
    "test:mobile:rating": "node scripts/run-maestro.js flow-devotee-rating.yaml"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/themed": "^1.1.73",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-query": "^5.90.11",
    "axios": "^1.12.2",
    "expo": "^56.0.4",
    "expo-constants": "^56.0.15",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-image-picker": "~56.0.13",
    "expo-intent-launcher": "~56.0.4",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "^56.0.11",
    "expo-location": "~56.0.13",
    "expo-notifications": "~56.0.13",
    "expo-router": "^56.2.6",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.13",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "firebase": "^12.11.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-calendars": "^1.1313.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-razorpay": "^2.3.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "baseline-browser-mapping": "^2.8.32",
    "jest": "~29.7.0",
    "jest-expo": "^56.0.4",
    "react-test-renderer": "^19.1.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "react-native",
    "transform": {
      "^.+\\.(js|ts|tsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|expo|@expo|@unimodules|unimodules|react-navigation|@react-navigation|@react-native-community|@expo-google-fonts|expo-asset|expo-font|expo-constants|expo-router|expo-secure-store|expo-document-picker|expo-file-system|expo-modules-core|expo-location|expo-image-picker|expo-notifications|expo-sharing|expo-device|expo-linking|expo-intent-launcher|expo-web-browser|firebase|@react-navigation/native|@react-navigation/native-stack)/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  }
}
